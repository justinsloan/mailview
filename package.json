{
  "name": "mailview",
  "version": "1.0.0",
  "description": "Safe previewer for suspected phishing email messages (.eml, .emlx, .msg, .mht)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test:parse": "node scripts/parse-check.js",
    "dist": "electron-builder --linux",
    "pack": "electron-builder --linux --dir",
    "dist:win": "electron-builder --win",
    "pack:win": "electron-builder --win --dir"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justinsloan/mailview.git"
  },
  "homepage": "https://github.com/justinsloan/mailview#readme",
  "bugs": {
    "url": "https://github.com/justinsloan/mailview/issues"
  },
  "dependencies": {
    "@kenjiuno/decompressrtf": "^0.1.4",
    "@kenjiuno/msgreader": "^1.28.0",
    "dompurify": "^3.4.17",
    "iconv-lite": "^0.7.3",
    "mailparser": "^3.9.38",
    "rtf-stream-parser": "^4.0.0"
  },
  "devDependencies": {
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3"
  },
  "private": true,
  "author": {
    "name": "Justin Sloan"
  },
  "build": {
    "appId": "local.mailview.viewer",
    "productName": "MailView",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "!**/*.map"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "category": "Network;Email;Security",
      "icon": "build/icon.png",
      "synopsis": "Safe previewer for suspected phishing emails",
      "syncDesktopName": true,
      "maintainer": "Justin Sloan <10264528+justinsloan@users.noreply.github.com>",
      "vendor": "Justin Sloan",
      "mimeTypes": [
        "message/rfc822",
        "application/x-mimearchive",
        "application/vnd.ms-outlook",
        "application/x-emlx"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "MailView-${version}-win-${arch}.${ext}"
    },
    "copyright": "Copyright © 2026 Justin Sloan",
    "deb": {
      "fpm": [
        "build/linux/mailview-mime.xml=/usr/share/mime/packages/mailview.xml"
      ]
    },
    "rpm": {
      "fpm": [
        "build/linux/mailview-mime.xml=/usr/share/mime/packages/mailview.xml"
      ]
    },
    "appImage": {
      "executableArgs": []
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "buildUniversalInstaller": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MailView",
      "deleteAppDataOnUninstall": true,
      "include": "build/win/installer.nsh",
      "license": "LICENSE",
      "artifactName": "MailView-Setup-${version}-${arch}.${ext}"
    }
  },
  "desktopName": "mailview.desktop"
}
